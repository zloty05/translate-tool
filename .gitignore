# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Supabase CLI — stan lokalny (supabase/ ma też własny .gitignore)
supabase/.temp/
supabase/.branches/

# Claude Code — lokalna lista uprawnień (per maszyna)
.claude/settings.local.json

# Materiały robocze klienta (kursy XLIFF/PPTX, tłumaczenia, zrzuty ekranu).
# Zostają lokalnie — do repo trafia tylko kod i dokumentacja.
# Wyjątek: docs/dziennik/ (dziennik projektu) jest śledzony.
docs/*
!docs/dziennik/
